<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Ana Yancy Aguilar Prado
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS principal del portafolio -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <!-- CSS del footer -->
    <link rel="stylesheet"
          href="~/css/footer.css"
          asp-append-version="true" />

    <!-- CSS generado por ASP.NET -->
    <link rel="stylesheet"
          href="~/AnaYancyPortfolio.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    <!-- =====================================================
         NAVBAR
         ===================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg portfolio-navbar">

            <div class="container">


                <!-- LOGO -->

                <a class="navbar-brand portfolio-logo"
                   asp-controller="Home"
                   asp-action="Index">

                    <span>ANA</span>
                    <strong> YANCY</strong>

                </a>


                <!-- BOTÓN RESPONSIVE -->
            
                <button class="navbar-toggler portfolio-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Abrir navegación">

                    ☰

                </button>


                <!-- MENÚ -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto">


                        <li class="nav-item">

                            <a class="nav-link portfolio-nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Inicio

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link portfolio-nav-link"
                               asp-controller="Home"
                               asp-action="SobreMi">

                                Sobre mí

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link portfolio-nav-link"
                               asp-controller="Home"
                               asp-action="Habilidades">

                                Habilidades

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link portfolio-nav-link"
                               asp-controller="Home"
                               asp-action="Proyectos">

                                Proyectos

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link portfolio-nav-link"
                               asp-controller="Home"
                               asp-action="Certificaciones">

                                Certificaciones

                            </a>

                        </li>
                        <!-- CONTACTO -->

                        <li class="nav-item">

                            <a class="nav-link portfolio-nav-link"
                               asp-controller="Home"
                               asp-action="Contacto">

                                Contacto

                            </a>

                        </li>


                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         CONTENIDO DE CADA PÁGINA
         ===================================================== -->

    <main>

        @RenderBody()

    </main>


    <!-- =====================================================
     FOOTER
===================================================== -->

    <footer class="portfolio-footer">

        
        <div class="container">

            <div class="row align-items-center">

                <!-- COPYRIGHT -->
                <div class="col-lg-4 mb-3 mb-lg-0">

                    <p class="mb-0">
                        © 2026 Ana Yancy Aguilar Prado
                    </p>

                </div>


                <!-- CONTACTO Y REDES -->
                <div class="col-lg-8">

                    <div class="footer-links">

                        <!-- WHATSAPP -->
                        <a href="https://wa.me/50688486016"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="footer-link"
                           aria-label="Contactar por WhatsApp">

                            <i class="bi bi-whatsapp"></i>
                            <span>WhatsApp</span>

                        </a>

                        <!-- LINKEDIN -->

                        <a href="https://www.linkedin.com/in/ana-yancy-aguilar-prado"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="footer-link"
                           aria-label="Perfil de Ana Yancy Aguilar Prado en LinkedIn">

                            
                            <i class="bi bi-linkedin"></i>
                            <span>LinkedIn</span>
                            

                        </a>


                        <!-- GITHUB -->

                        <a href="https://github.com/AnaYancyA"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="footer-link"
                           aria-label="GitHub de Ana Yancy Aguilar Prado">

                            
                            <i class="bi bi-github"></i>
                            <span>GitHub</span>
                            

                        </a>


                        <!-- CORREO -->

                        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=lic.anayancyaguilar@gmail.com"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="footer-link">

                            
                            <i class="bi bi-envelope-fill"></i>
                            <span>Correo</span>
                            

                        </a>


                    </div>

                </div>

            </div>

        </div>
        

    </footer>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>