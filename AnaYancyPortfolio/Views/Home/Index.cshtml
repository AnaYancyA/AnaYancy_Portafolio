@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/inicio.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
}

<!-- =====================================================
     HERO
===================================================== -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center hero-row">

            <!-- =====================================================
                 TEXTO
            ===================================================== -->

            <div class="col-lg-7">

                <div class="hero-content fade-in">

                    <p class="hero-subtitle">
                        HOLA, SOY
                    </p>

                    <h1 class="hero-title">
                        ANA YANCY
                        <span>AGUILAR PRADO</span>
                    </h1>

                    <h2 class="hero-role">
                        Ingeniera en Sistemas
                        <span>|</span>
                        Full Stack Developer
                    </h2>

                    <p class="hero-description">
                        Desarrollo soluciones digitales utilizando
                        C#, .NET, Python, SQL, WordPress y Microsoft Azure.
                        Puedo transformar ideas en aplicaciones
                        funcionales, modernas y escalables.
                    </p>

                    <!-- TECNOLOGÍAS -->

                    <div class="hero-technologies">

                        <span>
                            <i class="devicon-csharp-plain colored"></i>
                            C#
                        </span>

                        <span>
                            <i class="devicon-dotnetcore-plain colored"></i>
                            .NET
                        </span>

                        <span>
                            <i class="devicon-python-plain colored"></i>
                            Python
                        </span>

                        <span>
                            <i class="devicon-microsoftsqlserver-plain colored"></i>
                            SQL
                        </span>

                        <span>
                            <i class="devicon-wordpress-plain colored"></i>
                            WordPress
                        </span>

                        <span>
                            <i class="devicon-azure-plain colored"></i>
                            Azure
                        </span>

                    </div>
                    <!-- BOTONES -->

                    <div class="hero-buttons">

                        <a asp-controller="Home"
                           asp-action="Proyectos"
                           class="btn-primary-custom">
                            Ver proyectos
                        </a>

                        <a asp-controller="Home"
                           asp-action="Contacto"
                           class="btn-outline-custom">
                            Contáctame
                        </a>

                        <a href="~/documents/CV Ana Yancy Aguilar Prado-Desarrolladora de Software Full Stack .Net (2).pdf"
                           class="btn-outline-custom"
                           download>
                            Descargar CV
                        </a>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 ELEMENTO VISUAL
            ===================================================== -->

            <div class="col-lg-5">

                <div class="hero-visual">

                    <!-- DECORACIÓN -->

                    <div class="hero-circle circle-one"></div>
                    <div class="hero-circle circle-two"></div>


                  
                        <!-- =================================================
                             LAPTOP
                        ================================================= -->

                        <div class="laptop">

                            <div class="laptop-screen">

                                <div class="laptop-camera"></div>

                                <div class="laptop-code">

                                    <span>public class</span> AnaYancy

                                    <br>
                                    {

                                    <br>

                                    &nbsp;&nbsp;<span>string</span> Role =
                                    "Full Stack Developer";

                                    <br>

                                    &nbsp;&nbsp;<span>string</span> Stack =
                                    "C# .NET Python SQL Azure";

                                    <br>

                                    &nbsp;&nbsp;<span>string</span> Focus =
                                    "Digital Solutions";

                                    <br>

                                    }

                                </div>

                            </div>

                            <div class="laptop-base"></div>

                        </div>


                        
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     ESTADÍSTICAS
===================================================== -->

<section class="stats-section">

    <div class="container">

        <div class="row">

            <!-- CERTIFICACIONES -->

            <div class="col-md-4">

                <div class="stat-item">

                    <div class="stat-icon">
                        <i class="bi bi-patch-check"></i>
                    </div>

                    <div>

                        <h3>9</h3>

                        <p>
                            Certificaciones<br>
                            obtenidas
                        </p>

                    </div>

                </div>

            </div>


            <!-- CERTIFICADOS -->

            <div class="col-md-4">

                <div class="stat-item">

                    <div class="stat-icon">
                        <i class="bi bi-award"></i>
                    </div>

                    <div>

                        <h3>4</h3>

                        <p>
                            Certificados de<br>
                            formación
                        </p>

                    </div>

                </div>

            </div>


            <!-- ACTUALIZACIÓN -->

            <div class="col-md-4">

                <div class="stat-item">

                    <div class="stat-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div>

                        <h3>Actualización</h3>

                        <p>
                            Constante en las últimas<br>
                            tecnologías
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


@await Html.PartialAsync("_SobreMi")