<section class="contact-section">

    <!-- DECORACIONES DE FONDO -->
    <div class="contact-bg-shape contact-bg-left"></div>
    <div class="contact-bg-shape contact-bg-right"></div>


    <!-- DECORACIÓN LATERAL IZQUIERDA -->
    <div class="contact-side-decoration contact-decoration-left">

        <span class="circle circle-top"></span>
        <span class="circle circle-bottom"></span>

        <div class="dots dots-left">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
        </div>

    </div>


    <!-- DECORACIÓN LATERAL DERECHA -->
    <div class="contact-side-decoration contact-decoration-right">

        <span class="circle circle-top"></span>
        <span class="circle circle-bottom"></span>

        <div class="dots dots-right">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
        </div>

    </div>


    <div class="container">

       

        <!-- =================================================
             ENCABEZADO
        ================================================== -->

        <div class="contact-header">

            <div class="contact-decoration">

                <span></span>

                <i class="bi bi-stars"></i>

                <span></span>

            </div>

            <span class="contact-label">
                CONTACTO
            </span>

            <h1>
                Hablemos de tu próximo
                <span>proyecto.</span>
            </h1>

            <div class="contact-highlights">

                <div class="contact-highlight">
                    <i class="bi bi-lightbulb"></i>
                    <span>Nuevas ideas</span>
                </div>

                <div class="contact-highlight">
                    <i class="bi bi-briefcase"></i>
                    <span>Oportunidades</span>
                </div>

                <div class="contact-highlight">
                    <i class="bi bi-people"></i>
                    <span>Colaboraciones</span>
                </div>

            </div>

        </div> 
        <!-- CIERRE DE contact-header -->

        <!-- =================================================
             CONTENIDO PRINCIPAL
        ================================================== -->

        <div class="row g-4 contact-row">


            <!-- =================================================
                 INFORMACIÓN
            ================================================== -->

            <div class="col-lg-5">

                <div class="contact-info">

                    <!-- DECORACIÓN -->
                    <div class="contact-info-circle"></div>


                    <h2>
                        Conversemos
                    </h2>


                    <p class="contact-description">
                        Puedes contactarme directamente a través de mis
                        diferentes medios. Estaré encantada de conocer
                        tu proyecto o propuesta.
                    </p>


                    <!-- CORREO -->

                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-envelope"></i>
                        </div>

                        <div class="contact-item-text">

                            <span>
                                CORREO ELECTRÓNICO
                            </span>

                            <a href="mailto:lic.anayancyaguilar@gmail.com">
                                lic.anayancyaguilar@gmail.com
                            </a>

                        </div>

                    </div>


                    <!-- UBICACIÓN -->

                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-geo-alt"></i>
                        </div>

                        <div class="contact-item-text">

                            <span>
                                UBICACIÓN
                            </span>

                            <p>
                                Costa Rica
                            </p>

                        </div>

                    </div>


                    <!-- PERFIL PROFESIONAL -->

                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-briefcase"></i>
                        </div>

                        <div class="contact-item-text">

                            <span>
                                PERFIL PROFESIONAL
                            </span>

                            <p>
                                Systems Engineer | Full Stack Developer
                            </p>

                        </div>

                    </div>


                    <!-- REDES -->

                    <div class="contact-social">

                        <!-- GITHUB -->

                        <a href="https://github.com/AnaYancyA"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="GitHub">

                            <i class="bi bi-github"></i>

                        </a>


                        <!-- LINKEDIN -->

                        <a href="https://www.linkedin.com/in/ana-yancy-aguilar-prado"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="LinkedIn">

                            <i class="bi bi-linkedin"></i>

                        </a>


                        <!-- WHATSAPP -->

                        <a href="https://api.whatsapp.com/send/?phone=50688486016&text&type=phone_number&app_absent=0"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="WhatsApp">

                            <i class="bi bi-whatsapp"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 FORMULARIO
            ================================================== -->

            <div class="col-lg-7">

                <div class="contact-form-card">

                    <div class="form-header">

                        <span>
                            ESCRÍBEME
                        </span>

                        <h2>
                            Envíame un mensaje
                        </h2>

                    </div>
                    <form asp-controller="Home"
                          asp-action="Contacto"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- NOMBRE -->
                        <div class="form-group">

                            <label for="nombre">Nombre</label>

                            <div class="input-wrapper">

                                <i class="bi bi-person"></i>

                                <input type="text"
                                       id="nombre"
                                       name="Nombre"
                                       placeholder="Tu nombre"
                                       required />

                            </div>

                        </div>


                        <!-- CORREO -->
                        <div class="form-group">

                            <label for="email">Correo electrónico</label>

                            <div class="input-wrapper">

                                <i class="bi bi-envelope"></i>

                                <input type="email"
                                       id="email"
                                       name="Email"
                                       placeholder="tu@email.com"
                                       required />

                            </div>

                        </div>


                        <!-- ASUNTO -->
                        <div class="form-group">

                            <label for="asunto">Asunto</label>

                            <div class="input-wrapper">

                                <i class="bi bi-file-text"></i>

                                <input type="text"
                                       id="asunto"
                                       name="Asunto"
                                       placeholder="¿En qué puedo ayudarte?"
                                       required />

                            </div>

                        </div>


                        <!-- MENSAJE -->
                        <div class="form-group">

                            <label for="mensaje">Mensaje</label>

                            <div class="input-wrapper textarea-wrapper">

                                <i class="bi bi-chat-left-text"></i>

                                <textarea id="mensaje"
                                          name="Mensaje"
                                          placeholder="Cuéntame sobre tu proyecto..."
                                          required></textarea>

                            </div>

                        </div>


                        <!-- BOTÓN -->
                        <button type="submit"
                                class="btn-contact">

                            <span>Enviar mensaje</span>

                            <i class="bi bi-arrow-up-right"></i>

                        </button>

                    </form>

                </div> 

            </div> 

        </div> 

            <!-- =====================================================
             NAVEGACIÓN ENTRE PÁGINAS
        ===================================================== -->

        <div class="page-navigation">

            <a asp-controller="Home"
               asp-action="Certificaciones"
               class="btn-outline-custom">

                ← Anterior

            </a>


            <a asp-controller="Home"
               asp-action="Index"
               class="btn-primary-custom">

                Inicio

            </a>

        </div>


    </div> <!


</section>


@section Styles {

    <link rel="stylesheet"
          href="~/css/contacto.css"
          asp-append-version="true" />

}