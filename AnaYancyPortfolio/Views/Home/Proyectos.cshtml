           <script>

                document.addEventListener("DOMContentLoaded", function () {

                // =====================================================
                // PROYECTO 02 - FACTURACIÓN
                // =====================================================

                const facturacionGallery =
                document.getElementById("facturacionThumbs");

                if (facturacionGallery) {

                    const facturacionThumbs =
                Array.from(
                facturacionGallery.querySelectorAll(
                ".project-mobile-thumb"
                )
                );

                const facturacionPrev =
                document.getElementById(
                "facturacionThumbPrev"
                );

                const facturacionNext =
                document.getElementById(
                "facturacionThumbNext"
                );

                const facturacionIndicator =
                document.getElementById(
                "facturacionThumbIndicator"
                );

                const facturacionMainImage =
                document.getElementById(
                "facturacionMainImage"
                );

                let facturacionPage = 0;

                const facturacionItemsPerPage = 5;


                function showFacturacionPage(page) {

                    facturacionPage = page;

                const start =
                page * facturacionItemsPerPage;

                const end =
                start + facturacionItemsPerPage;


                facturacionThumbs.forEach(
                function (thumb, index) {

                    thumb.style.display =
                    index >= start &&
                        index < end
                        ? "block"
                        : "none";

                            }
                );


                facturacionIndicator.textContent =
                `${start + 1}–${Math.min(
                    end,
                    facturacionThumbs.length
                )} / ${facturacionThumbs.length}`;


                facturacionPrev.disabled =
                facturacionPage === 0;


                facturacionNext.disabled =
                            facturacionPage >=
                Math.ceil(
                facturacionThumbs.length /
                facturacionItemsPerPage
                ) - 1;

                    }


                facturacionNext.addEventListener(
                "click",
                function () {

                            const totalPages =
                Math.ceil(
                facturacionThumbs.length /
                facturacionItemsPerPage
                );


                if (
                facturacionPage <
                    totalPages - 1
                ) {

                    showFacturacionPage(
                        facturacionPage + 1
                    );

                            }

                        }
                );


                facturacionPrev.addEventListener(
                "click",
                function () {

                            if (facturacionPage > 0) {

                    showFacturacionPage(
                        facturacionPage - 1
                    );

                            }

                        }
                );


                facturacionThumbs.forEach(
                function (thumb) {

                    thumb.addEventListener(
                        "click",
                        function() {

                            facturacionMainImage.src =
                                thumb.dataset.image;

                            facturacionMainImage.alt =
                                thumb.dataset.alt || "";

                        }
                    );

                        }
                );


                showFacturacionPage(0);

                }



                // =====================================================
                // PROYECTO 03 - SOPORTE DE TIQUETES
                // =====================================================

                const soporteGallery =
                document.getElementById(
                "soporteThumbs"
                );


                if (soporteGallery) {

                    const soporteThumbs =
                Array.from(
                soporteGallery.querySelectorAll(
                ".project-mobile-thumb"
                )
                );


                const soportePrev =
                document.getElementById(
                "soporteThumbPrev"
                );


                const soporteNext =
                document.getElementById(
                "soporteThumbNext"
                );


                const soporteIndicator =
                document.getElementById(
                "soporteThumbIndicator"
                );


                const soporteMainImage =
                document.getElementById(
                "soporteMainImage"
                );


                let soportePage = 0;

                const soporteItemsPerPage = 5;


                function showSoportePage(page) {

                    soportePage = page;

                const start =
                page * soporteItemsPerPage;

                const end =
                start + soporteItemsPerPage;


                soporteThumbs.forEach(
                function (thumb, index) {

                    thumb.style.display =
                    index >= start &&
                        index < end
                        ? "block"
                        : "none";

                            }
                );


                soporteIndicator.textContent =
                `${start + 1}–${Math.min(
                    end,
                    soporteThumbs.length
                )} / ${soporteThumbs.length}`;


                soportePrev.disabled =
                soportePage === 0;


                soporteNext.disabled =
                            soportePage >=
                Math.ceil(
                soporteThumbs.length /
                soporteItemsPerPage
                ) - 1;

                    }


                soporteNext.addEventListener(
                "click",
                function () {

                            const totalPages =
                Math.ceil(
                soporteThumbs.length /
                soporteItemsPerPage
                );


                if (
                soportePage <
                    totalPages - 1
                ) {

                    showSoportePage(
                        soportePage + 1
                    );

                            }

                        }
                );


                soportePrev.addEventListener(
                "click",
                function () {

                            if (soportePage > 0) {

                    showSoportePage(
                        soportePage - 1
                    );

                            }

                        }
                );


                soporteThumbs.forEach(
                function (thumb) {

                    thumb.addEventListener(
                        "click",
                        function() {

                            soporteMainImage.src =
                                thumb.dataset.image;

                            soporteMainImage.alt =
                                thumb.dataset.alt || "";

                        }
                    );

                        }
                );


                showSoportePage(0);

                }

            });

    </script>
