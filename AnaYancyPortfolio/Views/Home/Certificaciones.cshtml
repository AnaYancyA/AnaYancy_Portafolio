<!-- =====================================================
     JAVASCRIPT DEL VISOR
     ===================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const previews =
            document.querySelectorAll(".certificado-preview");

        const modal =
            document.getElementById("certificadoModal");

        const modalImagen =
            document.getElementById("certificadoModalImagen");

        const cerrar =
            document.getElementById("certificadoCerrar");


        // Verificar elementos

        if (!previews.length || !modal || !modalImagen || !cerrar) {
            return;
        }


        // =================================================
        // ABRIR IMAGEN
        // =================================================

        previews.forEach(function (preview) {

            preview.addEventListener("click", function () {

                const imagen =
                    preview.querySelector("img");

                if (!imagen) {
                    return;
                }

                modalImagen.src = imagen.src;

                modalImagen.alt = imagen.alt;

                modal.classList.add("activo");

                document.body.style.overflow = "hidden";

            });

        });


        // =================================================
        // CERRAR CON X
        // =================================================

        cerrar.addEventListener("click", function () {

            modal.classList.remove("activo");

            modalImagen.src = "";

            document.body.style.overflow = "";

        });


        // =================================================
        // CERRAR HACIENDO CLICK EN EL FONDO
        // =================================================

        modal.addEventListener("click", function (event) {

            if (event.target === modal) {

                modal.classList.remove("activo");

                modalImagen.src = "";

                document.body.style.overflow = "";

            }

        });


        // =================================================
        // CERRAR CON ESC
        // =================================================

        document.addEventListener("keydown", function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("activo")
            ) {

                modal.classList.remove("activo");

                modalImagen.src = "";

                document.body.style.overflow = "";

            }

        });

    });

</script>


